# Supabase — self-hosted
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # agent only — never expose to frontend

# Supabase DB (for migrations)
POSTGRES_PASSWORD=
POSTGRES_DB=tapeworm

# JWT
JWT_SECRET=                   # min 32 chars, generate with: openssl rand -base64 32

# Transfer agent
AGENT_POLL_INTERVAL_MS=500
AGENT_LOG_LEVEL=info          # debug | info | warn | error

# Shop floor network
FLOOR_NETWORK_CIDR=192.168.10.0/24

# Moxa NPort — lathe area (5610-16)
MOXA_LATHE_HOST=192.168.10.10
MOXA_LATHE_BASE_PORT=4001     # port 4001=machine 1, 4002=machine 2 ... 4016=machine 16

# Moxa NPort — mill area (5650-16)
MOXA_MILL_HOST=192.168.10.11
MOXA_MILL_BASE_PORT=4001

# Pi Zero — USB gadget machines
PI_ZERO_1_HOST=192.168.10.20
PI_ZERO_2_HOST=192.168.10.21

# Vite (web app — only VITE_ prefix is exposed to browser)
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=
